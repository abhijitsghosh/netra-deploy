{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "_generator": {
      "name": "bicep",
      "version": "0.43.8.12551",
      "templateHash": "13619345645050255228"
    }
  },
  "parameters": {
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]",
      "metadata": {
        "description": "Azure region."
      }
    },
    "namePrefix": {
      "type": "string",
      "defaultValue": "netra",
      "metadata": {
        "description": "Resource name prefix."
      }
    },
    "image": {
      "type": "string",
      "defaultValue": "ghcr.io/abhijitsghosh/netra:latest",
      "metadata": {
        "description": "Container image to run."
      }
    },
    "entraTenantId": {
      "type": "string",
      "metadata": {
        "description": "Entra tenant id (for both sign-in and the report deep links)."
      }
    },
    "entraClientId": {
      "type": "string",
      "metadata": {
        "description": "Entra application (client) id for user sign-in."
      }
    },
    "entraClientSecret": {
      "type": "securestring",
      "metadata": {
        "description": "Entra client secret for the confidential OIDC client."
      }
    },
    "subscriptionsCsv": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Comma-separated subscription ids to scan; empty = all readable."
      }
    },
    "dbAdminUser": {
      "type": "string",
      "defaultValue": "netra",
      "metadata": {
        "description": "Postgres administrator login."
      }
    },
    "dbAdminPassword": {
      "type": "securestring",
      "metadata": {
        "description": "Postgres administrator password."
      }
    },
    "dbName": {
      "type": "string",
      "defaultValue": "netra",
      "metadata": {
        "description": "Database name."
      }
    }
  },
  "resources": [
    {
      "type": "Microsoft.DBforPostgreSQL/flexibleServers/databases",
      "apiVersion": "2024-08-01",
      "name": "[format('{0}/{1}', format('{0}-db', parameters('namePrefix')), parameters('dbName'))]",
      "dependsOn": [
        "[resourceId('Microsoft.DBforPostgreSQL/flexibleServers', format('{0}-db', parameters('namePrefix')))]"
      ]
    },
    {
      "type": "Microsoft.DBforPostgreSQL/flexibleServers/firewallRules",
      "apiVersion": "2024-08-01",
      "name": "[format('{0}/{1}', format('{0}-db', parameters('namePrefix')), 'AllowAzureServices')]",
      "properties": {
        "startIpAddress": "0.0.0.0",
        "endIpAddress": "0.0.0.0"
      },
      "dependsOn": [
        "[resourceId('Microsoft.DBforPostgreSQL/flexibleServers', format('{0}-db', parameters('namePrefix')))]"
      ]
    },
    {
      "type": "Microsoft.ManagedIdentity/userAssignedIdentities",
      "apiVersion": "2023-01-31",
      "name": "[format('{0}-mi', parameters('namePrefix'))]",
      "location": "[parameters('location')]"
    },
    {
      "type": "Microsoft.DBforPostgreSQL/flexibleServers",
      "apiVersion": "2024-08-01",
      "name": "[format('{0}-db', parameters('namePrefix'))]",
      "location": "[parameters('location')]",
      "sku": {
        "name": "Standard_B1ms",
        "tier": "Burstable"
      },
      "properties": {
        "version": "16",
        "administratorLogin": "[parameters('dbAdminUser')]",
        "administratorLoginPassword": "[parameters('dbAdminPassword')]",
        "storage": {
          "storageSizeGB": 32
        },
        "backup": {
          "backupRetentionDays": 7,
          "geoRedundantBackup": "Disabled"
        },
        "highAvailability": {
          "mode": "Disabled"
        }
      }
    },
    {
      "type": "Microsoft.OperationalInsights/workspaces",
      "apiVersion": "2023-09-01",
      "name": "[format('{0}-logs', parameters('namePrefix'))]",
      "location": "[parameters('location')]",
      "properties": {
        "sku": {
          "name": "PerGB2018"
        },
        "retentionInDays": 30
      }
    },
    {
      "type": "Microsoft.App/managedEnvironments",
      "apiVersion": "2024-03-01",
      "name": "[format('{0}-env', parameters('namePrefix'))]",
      "location": "[parameters('location')]",
      "properties": {
        "appLogsConfiguration": {
          "destination": "log-analytics",
          "logAnalyticsConfiguration": {
            "customerId": "[reference(resourceId('Microsoft.OperationalInsights/workspaces', format('{0}-logs', parameters('namePrefix'))), '2023-09-01').customerId]",
            "sharedKey": "[listKeys(resourceId('Microsoft.OperationalInsights/workspaces', format('{0}-logs', parameters('namePrefix'))), '2023-09-01').primarySharedKey]"
          }
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.OperationalInsights/workspaces', format('{0}-logs', parameters('namePrefix')))]"
      ]
    },
    {
      "type": "Microsoft.App/containerApps",
      "apiVersion": "2024-03-01",
      "name": "[format('{0}-app', parameters('namePrefix'))]",
      "location": "[parameters('location')]",
      "identity": {
        "type": "UserAssigned",
        "userAssignedIdentities": {
          "[format('{0}', resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', format('{0}-mi', parameters('namePrefix'))))]": {}
        }
      },
      "properties": {
        "managedEnvironmentId": "[resourceId('Microsoft.App/managedEnvironments', format('{0}-env', parameters('namePrefix')))]",
        "configuration": {
          "ingress": {
            "external": true,
            "targetPort": 8080,
            "transport": "auto"
          },
          "secrets": [
            {
              "name": "entra-client-secret",
              "value": "[parameters('entraClientSecret')]"
            },
            {
              "name": "db-password",
              "value": "[parameters('dbAdminPassword')]"
            }
          ]
        },
        "template": {
          "containers": [
            {
              "name": "netra",
              "image": "[parameters('image')]",
              "resources": {
                "cpu": 1,
                "memory": "2Gi"
              },
              "env": [
                {
                  "name": "NETRA_AUTH_ENABLED",
                  "value": "true"
                },
                {
                  "name": "NETRA_DB_URL",
                  "value": "[format('jdbc:postgresql://{0}:5432/{1}?sslmode=require', reference(resourceId('Microsoft.DBforPostgreSQL/flexibleServers', format('{0}-db', parameters('namePrefix'))), '2024-08-01').fullyQualifiedDomainName, parameters('dbName'))]"
                },
                {
                  "name": "NETRA_DB_USER",
                  "value": "[parameters('dbAdminUser')]"
                },
                {
                  "name": "NETRA_DB_PASSWORD",
                  "secretRef": "db-password"
                },
                {
                  "name": "NETRA_ENTRA_TENANT_ID",
                  "value": "[parameters('entraTenantId')]"
                },
                {
                  "name": "NETRA_ENTRA_CLIENT_ID",
                  "value": "[parameters('entraClientId')]"
                },
                {
                  "name": "NETRA_ENTRA_CLIENT_SECRET",
                  "secretRef": "entra-client-secret"
                },
                {
                  "name": "NETRA_TENANT_ID",
                  "value": "[parameters('entraTenantId')]"
                },
                {
                  "name": "NETRA_CLIENT_ID",
                  "value": "[parameters('entraClientId')]"
                },
                {
                  "name": "NETRA_MI_OBJECT_ID",
                  "value": "[reference(resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', format('{0}-mi', parameters('namePrefix'))), '2023-01-31').principalId]"
                },
                {
                  "name": "NETRA_MI_NAME",
                  "value": "[format('{0}-mi', parameters('namePrefix'))]"
                },
                {
                  "name": "NETRA_SUBSCRIPTIONS",
                  "value": "[parameters('subscriptionsCsv')]"
                },
                {
                  "name": "AZURE_CLIENT_ID",
                  "value": "[reference(resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', format('{0}-mi', parameters('namePrefix'))), '2023-01-31').clientId]"
                }
              ],
              "probes": [
                {
                  "type": "Liveness",
                  "httpGet": {
                    "path": "/actuator/health/liveness",
                    "port": 8080
                  },
                  "initialDelaySeconds": 20,
                  "periodSeconds": 15
                },
                {
                  "type": "Readiness",
                  "httpGet": {
                    "path": "/actuator/health/readiness",
                    "port": 8080
                  },
                  "initialDelaySeconds": 15,
                  "periodSeconds": 15
                }
              ]
            }
          ],
          "scale": {
            "minReplicas": 1,
            "maxReplicas": 1
          }
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.App/managedEnvironments', format('{0}-env', parameters('namePrefix')))]",
        "[resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', format('{0}-mi', parameters('namePrefix')))]",
        "[resourceId('Microsoft.DBforPostgreSQL/flexibleServers', format('{0}-db', parameters('namePrefix')))]"
      ]
    }
  ],
  "outputs": {
    "appUrl": {
      "type": "string",
      "value": "[format('https://{0}', reference(resourceId('Microsoft.App/containerApps', format('{0}-app', parameters('namePrefix'))), '2024-03-01').configuration.ingress.fqdn)]"
    },
    "managedIdentityPrincipalId": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', format('{0}-mi', parameters('namePrefix'))), '2023-01-31').principalId]"
    },
    "managedIdentityClientId": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', format('{0}-mi', parameters('namePrefix'))), '2023-01-31').clientId]"
    }
  }
}